expression fx_ConfigMap =
		(fileName as text, valueColumn as text) as table =>
		let
		    Raw = Json.Document(File.Contents(RepoPath & "\" & DataSet & "\config\" & fileName)),
		    AsTable = Record.ToTable(Raw),
		    NoComments = Table.SelectRows(AsTable, each not Text.StartsWith([Name], "_")),
		    Renamed = Table.RenameColumns(NoComments, {{"Name", "asset_key"}, {"Value", valueColumn}})
		in
		    Renamed
	lineageTag: a2a8a021-898c-4f2a-b3b2-78bb42bb00f1
