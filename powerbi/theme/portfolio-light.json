{
  "name": "Portfolio Dashboard (light)",
  "dataColors": [
    "#0081cc",
    "#b56928",
    "#048c7d",
    "#8b7d12",
    "#c9518a",
    "#3c8c3d",
    "#a861b6",
    "#ce5458"
  ],
  "foreground": "#211d2e",
  "foregroundNeutralSecondary": "#4f4c5b",
  "foregroundNeutralTertiary": "#837f8d",
  "background": "#fcfcfb",
  "backgroundLight": "#efefef",
  "backgroundNeutral": "#e1dee9",
  "tableAccent": "#1a2ba6",
  "hyperlink": "#0081cc",
  "good": "#047f02",
  "neutral": "#837f8d",
  "bad": "#db0129",
  "maximum": "#3c8c3d",
  "center": "#837f8d",
  "minimum": "#ce5458",
  "textClasses": {
    "callout": {
      "fontFace": "Georgia",
      "fontSize": 28,
      "color": "#211d2e"
    },
    "title": {
      "fontFace": "Georgia",
      "fontSize": 12,
      "color": "#211d2e"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#211d2e"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#4f4c5b"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#f9f9f7"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#f9f9f7"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#fcfcfb"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#e2e1e2"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#e1dee9"
              }
            },
            "gridlineStyle": "dotted"
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false
          }
        ]
      }
    }
  }
}
