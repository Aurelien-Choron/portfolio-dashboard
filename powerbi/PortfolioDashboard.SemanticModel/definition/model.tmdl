model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: fr-FR
	valueFilterBehavior: independent
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup Staging

	annotation PBI_QueryGroupOrder = 1

queryGroup Facts

	annotation PBI_QueryGroupOrder = 2

queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 3

queryGroup Staging\Fortuneo

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Staging\Trade Republic'

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["RepoPath","DataSet","stg_Fortuneo","fortuneo_SampleFile","fortuneo_SampleParam","fortuneo_TransformSample","fx_ParseFortuneoFile","stg_TradeRepublic","tradeRepublic_SampleFile","tradeRepublic_SampleParam","tradeRepublic_TransformSample","fx_ParseTradeRepublicFile","map_FortuneoOperation","map_TradeRepublicType","stg_Journal","CostBasisReplay","Transactions","AssetClass","stg_Strategy","stg_BrokerEnvelope","stg_Envelope","fx_ConfigMap","Broker","Prices","Asset","Exposure","Account","StrategyTarget","Institution"]

ref table Transactions
ref table AssetClass
ref table Broker
ref table Prices
ref table Asset
ref table Exposure
ref table Account
ref table StrategyTarget
ref table Date
ref table Institution
ref table _Measures

ref cultureInfo en-US

