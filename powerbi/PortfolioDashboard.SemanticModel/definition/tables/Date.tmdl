		annotation SummarizationSetBy = Automatic

	partition Date = calculated
		mode: import
		source =
				-- One row per day, from the first trade or price to the last frozen close.
				-- No future dates: "today" for this report is the last close (as of).
				VAR _start = MIN ( MIN ( Transactions[date] ), MIN ( Prices[date] ) )
				VAR _end = MAX ( Prices[date] )
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( _start, _end ),
				        "Year", YEAR ( [Date] ),
				        "Month Number", MONTH ( [Date] ),
				        "Month", FORMAT ( [Date], "mmm yyyy" ),
				        "Year Month", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				        "Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 )
				    )

	annotation PBI_Id = c1cc74ba-e556-4cca-aa78-a0e0330cb71a

